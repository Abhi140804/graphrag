# Optional Neo4j. If unset, an in-memory NetworkX graph is used.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional dense embeddings. Default is local TF-IDF (no model download).
# Example: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=

# Optional OpenAI-compatible LLM for richer extraction and answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
